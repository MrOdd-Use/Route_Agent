# Copy this file to `.env` and fill in real values.
# Example:
#   cp .env.example .env

# -----------------------------
# Provider API keys
# -----------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# OpenAI-compatible relay
# RELAY_API_KEY=
# RELAY_BASE_URL=https://your-relay-endpoint.example.com/api/common
# RELAY_DEFAULT_MODEL=claude-sonnet-4-6
# RELAY_ALLOWED_MODELS=
# RELAY_GROUPS=cc_glm,cc_kimi25,cc_minimax21,codex
# RELAY_CC_GLM_BASE_URL=https://your-relay-endpoint.example.com/api/cc_glm
# RELAY_CC_GLM_ALLOWED_MODELS=
# RELAY_CC_KIMI25_BASE_URL=https://your-relay-endpoint.example.com/api/cc_kimi25
# RELAY_CC_KIMI25_ALLOWED_MODELS=
# RELAY_CC_MINIMAX21_BASE_URL=https://your-relay-endpoint.example.com/api/cc_minimax21
# RELAY_CC_MINIMAX21_ALLOWED_MODELS=
# RELAY_CODEX_BASE_URL=https://your-relay-endpoint.example.com/api/codex
# RELAY_CODEX_ALLOWED_MODELS=

# Optional local model provider
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# -----------------------------
# Registry storage
# -----------------------------
ROUTE_AGENT_SQLITE_PATH=data/route_agent_registry.sqlite3
ROUTE_AGENT_POSTGRES_DSN=

# -----------------------------
# Router engine
# -----------------------------
ROUTER_DB_PATH=data/router_engine.db
REDIS_URL=
RATE_LIMIT_MODE=auto
RATE_LIMIT_FAIL_STRATEGY=degrade

# -----------------------------
# Monitoring (optional)
# -----------------------------
ROUTE_AGENT_MONITORING_ENABLED=false
ROUTE_AGENT_MONITORING_DB_PATH=data/route_agent_monitoring.db
ROUTE_AGENT_MONITORING_RETENTION_DAYS=30

# -----------------------------
# Optional pricing refresh flags
# -----------------------------
ENABLE_DYNAMIC_PRICING=0
DYNAMIC_PRICING_TIMEOUT_SECONDS=10
DYNAMIC_PRICING_CACHE_TTL_SECONDS=21600
# OPENAI_PRICING_URL=https://openai.com/api/pricing/
# DEEPSEEK_PRICING_URL=https://api-docs.deepseek.com/quick_start/pricing
# GOOGLE_PRICING_URL=https://ai.google.dev/gemini-api/docs/pricing

# -----------------------------
# Optional Arena leaderboard integration
# -----------------------------
ENABLE_ARENA_SCORING=0
ARENA_CACHE_DB_PATH=data/arena_cache.sqlite3
